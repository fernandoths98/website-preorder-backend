# Copy to .env on the VPS and fill in. .env is gitignored — never commit it.
#   cp .env.example .env && nano .env

# --- MySQL ---
# Only used the first time the data volume is created.
DB_ROOT_PASS=ganti-password-root-yang-panjang
DB_NAME=wpo
DB_USER=wpo_app
DB_PASS=ganti-password-app-yang-panjang

# --- Auth ---
# Minimal 32 karakter — divalidasi saat boot, app tidak mau start kalau kurang.
#   openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=12h

# --- Storefront ---
# Origin frontend, dipisah koma. Tanpa trailing slash.
CORS_ORIGINS=https://websitepreorder.online,https://www.websitepreorder.online

# Nomor WhatsApp admin untuk deep link checkout, format 62xxxxxxxxxx.
WA_ADMIN_PHONE=6285155202296


# --- NusaPay payment gateway ---
NUSAPAY_GATEWAY_URL=http://kotdee-nusapay-gateway:4010
NUSAPAY_QR_GENERATE_PATH=/api/v1/qr/qr-mpm-generate
NUSAPAY_QR_QUERY_PATH=/api/v1/qr/qr-mpm-query
NUSAPAY_TIMEOUT_MS=20000
WPO_PAYMENT_CALLBACK_KEY=
